// Modelos de identidad (Sprint 1) y modelos clínicos (Sprint 2).
// Códigos de autorización y refresh tokens se guardan solo como hash.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum BloodType {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum Severity {
  MILD
  MODERATE
  SEVERE
}

model User {
  id                String              @id @default(uuid())
  email             String              @unique
  passwordHash      String
  createdAt         DateTime            @default(now())
  refreshTokens     RefreshToken[]
  authCodes         AuthorizationCode[]
  healthProfile     HealthProfile?
  allergies         Allergy[]
  medications       Medication[]
  emergencyContacts EmergencyContact[]
  prescriptions     Prescription[]
  incidentLocations IncidentLocation[]
}

model AuthorizationCode {
  id            String    @id @default(uuid())
  userId        String
  codeHash      String    @unique
  codeChallenge String // S256
  redirectUri   String
  expiresAt     DateTime // 60 s
  usedAt        DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model HealthProfile {
  id        String     @id @default(uuid())
  userId    String     @unique
  bloodType BloodType?
  notes     String?    @db.VarChar(500)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Allergy {
  id       String   @id @default(uuid())
  userId   String
  name     String   @db.VarChar(100)
  severity Severity
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Medication {
  id             String    @id @default(uuid())
  userId         String
  name           String    @db.VarChar(100)
  dose           String    @db.VarChar(50)
  frequencyHours Int
  controlled     Boolean   @default(false)
  startsAt       DateTime
  endsAt         DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmergencyContact {
  id           String @id @default(uuid())
  userId       String
  name         String @db.VarChar(100)
  phone        String @db.VarChar(20)
  relationship String @db.VarChar(50)
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Prescription {
  id        String   @id @default(uuid())
  userId    String
  mimeType  String
  sizeBytes Int
  data      Bytes    // imagen comprimida (<= 2 MB)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model IncidentLocation {
  id         String   @id @default(uuid())
  userId     String
  latitude   Float
  longitude  Float
  recordedAt DateTime
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
