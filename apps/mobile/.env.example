# Copia este archivo a `.env` dentro de apps/mobile. Expo carga solo las variables EXPO_PUBLIC_*.
# En los builds de EAS la URL sale del perfil de eas.json, no de este archivo.

# API local: en emulador Android usa http://10.0.2.2:3000/api/v1; en un teléfono físico,
# la IP de tu laptop en la red o el túnel HTTPS (docker compose --profile tunnel up).
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
