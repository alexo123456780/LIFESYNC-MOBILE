# Copia este archivo a `.env` y reemplaza los valores. Nunca subas `.env` al repositorio.

# --- Base de datos (Docker Compose) ---
DB_USER=lifesync
DB_PASSWORD=
DB_NAME=lifesync_dev
# Puerto publicado en 127.0.0.1; cámbialo si el 5432 ya está en uso.
DB_PORT=5432

# --- API ---
# UID/GID con el que corre el contenedor de desarrollo (en Linux: `id -u` y `id -g`).
DEV_UID=1000
DEV_GID=1000
# Solo si corres el API fuera de Docker (Compose arma DATABASE_URL por su cuenta):
# DATABASE_URL=postgresql://USUARIO:CLAVE@localhost:5432/lifesync_dev
# Llaves ES256 en base64 (obligatorias). Generación, sin depender de openssl:
#   node -e "const c=require('crypto');const k=c.generateKeyPairSync('ec',{namedCurve:'P-256'});\
#     console.log('JWT_PRIVATE_KEY_B64='+Buffer.from(k.privateKey.export({type:'pkcs8',format:'pem'})).toString('base64'));\
#     console.log('JWT_PUBLIC_KEY_B64='+Buffer.from(k.publicKey.export({type:'spki',format:'pem'})).toString('base64'))"
# Emisor y audiencia del JWT (opcionales).
# JWT_ISSUER=lifesync-api
# JWT_AUDIENCE=lifesync-mobile
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
# Lista separada por comas; la comparación es exacta. En development agrega la URI exp:// de Expo Go.
OAUTH_REDIRECT_URIS=lifesync://oauth/callback

# --- Seed de desarrollo (npm run seed -w apps/api; solo con NODE_ENV=development) ---
SEED_USER_EMAIL=demo@lifesync.dev
SEED_USER_PASSWORD=

# --- pgAdmin (docker compose --profile tools up) ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=

# --- Túnel HTTPS opcional (docker compose --profile tunnel up) ---
NGROK_AUTHTOKEN=
